VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# 任意。未設定時はログインユーザーが所属する最初の有効店舗を使う。
# 設定する場合も、その店舗への有効な所属が必要。
VITE_DEFAULT_STORE_ID=

# 本番はWorkerと同一オリジンを使うため未設定でよい。ローカル開発時だけ指定する。
VITE_WORKER_BASE_URL=http://localhost:8787

# 開発時のログイン・登録・管理・プロフィール画面確認専用。allを指定する。
# 本番ビルドでは常に無効。
VITE_UI_PREVIEW_MODE=
